# Supabase PostgreSQL - ICMS Ecologico Nova Iguacu
# Cole suas URLs reais no arquivo .env, nunca neste .env.example.

# Use a URL do Pooler/Transaction Pooler do Supabase para a aplicacao.
DATABASE_URL="COLE_AQUI_A_DATABASE_URL_DO_POOLER_SUPABASE"

# Use a URL direta do PostgreSQL Supabase para migrations Prisma.
DIRECT_URL="COLE_AQUI_A_DIRECT_URL_SUPABASE"

# Configuracao local da API
NODE_ENV="development"
PORT="3000"

{
  "version": 2,
  "buildCommand": "npm run build && npx prisma generate",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
